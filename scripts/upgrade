#!/bin/bash

source _common.sh
source /usr/share/yunohost/helpers

normalize_exposure

ynh_script_progression "Upgrading OpenCode..."

if [ "${exposure:-}" = "web" ] && [ "${path:-/}" != "/" ]; then
    ynh_print_warn \
        "OpenCode web mode is installed at '${path}'. The web UI needs the domain root; change the app URL to '/' (or use a dedicated domain) to fix blank pages and failing asset requests."
fi

ynh_app_setting_set --key=vpn_bind_address --value="${vpn_bind_address:-}"
ynh_systemctl --service="$app" --action="stop" || true

# The official installer always resolves the current upstream release.
install_opencode_binary
configure_opencode_providers "${external_provider:-}" "${external_api_key:-}"

ynh_config_add_systemd
if [ "$exposure" = "web" ]; then
    prepare_opencode_web_auth
    ynh_config_add_nginx
fi
register_yunohost_service
install_opencode_logo

ynh_script_progression "Restarting OpenCode..."
ynh_systemctl --service="$app" --action="start"

register_remote_url

ynh_script_progression "Upgrade of $app completed"
